# .env 로 복사해서 값을 채운다. (.env는 git에 올라가지 않음)
ANTHROPIC_API_KEY=

# 자막을 못 받을 때 영상 분석용 (무료): https://aistudio.google.com/apikey 에서 발급
GEMINI_API_KEY=

# Telegram: @BotFather 에서 봇 생성 → 토큰. 봇에게 말 건 뒤 `.\td telegram-chat-id`
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ntfy를 쓸 경우: 추측하기 어려운 토픽 이름 (예: tube-digest-8f3k2q9x)
NTFY_TOPIC=
NTFY_TOKEN=
