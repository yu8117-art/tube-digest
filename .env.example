# .env 로 복사해서 값을 채운다. (.env는 git에 올라가지 않음)
# GitHub Actions로 돌릴 때는 같은 이름으로 저장소 Settings → Secrets에도 등록한다.

# 영상 요약 (무료): https://aistudio.google.com/apikey 에서 발급
GEMINI_API_KEY=

# 새 영상 감지·영상 길이 (무료, 하루 1만 단위 중 약 3,300 사용):
# Google Cloud Console → YouTube Data API v3 사용 설정 → 사용자 인증 정보 → API 키
# (AI Studio의 Gemini 키는 이 API에서 거부된다)
YOUTUBE_API_KEY=

# Telegram: @BotFather 에서 봇 생성 → 토큰. 봇에게 말 건 뒤 `.\td telegram-chat-id`
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ntfy를 쓸 경우: 추측하기 어려운 토픽 이름 (예: tube-digest-8f3k2q9x)
NTFY_TOPIC=
NTFY_TOKEN=
